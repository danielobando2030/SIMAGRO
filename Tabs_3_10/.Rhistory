writexl::write_xlsx(Salida,"C:/Users/danie/OneDrive/Escritorio/ContratoGobernacion/Mes5/Informe_actualización/Outputs/FEG1_cambio_abs.xlsx")
FEG1_cambio_rel<-function(antes,despues,recuperar,anio1=2025,anio2=2026){
despues$Periodo="Despues"
antes$Periodo="Antes"
despues$Caracter22 <- str_sub(despues$NUMERO_PREDIAL_NACIONAL, 22, 22)
despues$Caracter27_30 <- str_sub(despues$NUMERO_PREDIAL_NACIONAL, 27, 30)
despues$Condicion_NPredios=!(despues$Periodo=="Despues"&despues$Caracter22%in%c("8","9")&despues$Caracter27_30=="0000")
despues$Condicion_Aval_Area=!(despues$Periodo=="Despues"&despues$Caracter22%in%c("9")&despues$Caracter27_30=="0000")
despues=despues[despues$Condicion_Aval_Area,]
print("Verificar que las bases a crizar son homogeneas")
print(names(antes)[!names(antes)%in%names(despues)])
print(names(despues)[!names(despues)%in%names(antes)])
antes=antes %>% distinct(FICHA, Periodo, .keep_all = TRUE)
despues=despues %>% distinct(FICHA, Periodo, .keep_all = TRUE)
names(antes)=paste0(names(antes),"_antes")
names(despues)=paste0(names(despues),"_despues")
Ancho=merge(antes,despues,by.x="FICHA_antes",by.y="FICHA_despues",all=FALSE)
Columnas=c("AREA_TERRENO","AREA_CONSTRUIDA",
"AVALUO_CONSTRUCCION","AVALUO_TERRENO",
"AVALUO")
for(col in Columnas){
Ancho[[col]] <- ifelse(
Ancho[[paste0(col,"_antes")]] == 0,
NA,  # o el valor que quieras asignar
(Ancho[[paste0(col,"_despues")]] / Ancho[[paste0(col,"_antes")]]) - 1
)  }
Ancho=Ancho[,c("FICHA_antes",Columnas)]
Salida=reshape2::melt(Ancho, id="FICHA_antes")
Subio=Salida[Salida$value>=0,]
Bajo=Salida[Salida$value<=0,]
Estadisticas_generales_S <- Subio %>%
group_by(variable)%>%
summarise(Min=min(value,na.rm=TRUE),
Q1 =quantile(value, 0.25, na.rm = TRUE),
Q2 =quantile(value, 0.50, na.rm = TRUE),
Q3=quantile(value, 0.75, na.rm = TRUE),
Max=max(value,na.rm=TRUE),
Promedio=mean(value,na.rm=TRUE)
)
Estadisticas_generales_B <- Bajo %>%
group_by(variable)%>%
summarise(Min=min(abs(value),na.rm=TRUE),
Q1 =quantile(abs(value), 0.25, na.rm = TRUE),
Q2 =quantile(abs(value), 0.50, na.rm = TRUE),
Q3=quantile(abs(value), 0.75, na.rm = TRUE),
Max=max(abs(value),na.rm=TRUE),
Promedio=mean(abs(value),na.rm=TRUE)
)
Estadisticas_generales_B=Estadisticas_generales_B%>%
mutate(variable = recode(variable,
"AREA_TERRENO" = "Área de Terreno",
"AREA_CONSTRUIDA" = "Área Construida",
"AVALUO_CONSTRUCCION" = "Avalúo Construcción",
"AVALUO_TERRENO" = "Avalúo Terreno",
"AVALUO" = "Avalúo Total",
"Total_predios" = "Número de Predios",
"Total_propietarios" = "Número de Propietarios"))
Estadisticas_generales_S=Estadisticas_generales_S%>%
mutate(variable = recode(variable,
"AREA_TERRENO" = "Área de Terreno",
"AREA_CONSTRUIDA" = "Área Construida",
"AVALUO_CONSTRUCCION" = "Avalúo Construcción",
"AVALUO_TERRENO" = "Avalúo Terreno",
"AVALUO" = "Avalúo Total",
"Total_predios" = "Número de Predios",
"Total_propietarios" = "Número de Propietarios"))
# Función para porcentajes con coma
formato_porcentaje <- function(x) {
percent(x, accuracy = 0.01, decimal.mark = ",",big.mark=".")  # 2 decimales
}
# Aplicar a todas las columnas
cols <- c("Min","Q1","Q2","Q3","Max")
Estadisticas_generales_B[cols] <- lapply(Estadisticas_generales_B[cols], formato_porcentaje)
Estadisticas_generales_S[cols] <- lapply(Estadisticas_generales_S[cols], formato_porcentaje)
Estadisticas_generales_S <- Estadisticas_generales_S %>%
rename(
"Mínimo" = Min,
"Corte 25%" = Q1,
"Corte 50%" = Q2,
"Corte 75%" = Q3,
"Máximo" = Max
)
Estadisticas_generales_B=Estadisticas_generales_B%>%rename(
"Mínimo" = Min,
"Corte 25%" = Q1,
"Corte 50%" = Q2,
"Corte 75%" = Q3,
"Máximo" = Max
)
names(Estadisticas_generales_B)[1]="Variable Catastral"
names(Estadisticas_generales_S)[1]="Variable Catastral"
Salida1=list(Sube=Estadisticas_generales_S,
Baja=Estadisticas_generales_B)
return(Salida1)
}
