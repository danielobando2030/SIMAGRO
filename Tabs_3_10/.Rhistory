Destino_cambio_rel<-function(antes,despues,recuperar,anio1=2025,anio2=2026){
despues$Periodo="Despues"
antes$Periodo="Antes"
despues$Caracter22 <- str_sub(despues$NUMERO_PREDIAL_NACIONAL, 22, 22)
despues$Caracter27_30 <- str_sub(despues$NUMERO_PREDIAL_NACIONAL, 27, 30)
despues$Condicion_NPredios=!(despues$Periodo=="Despues"&despues$Caracter22%in%c("8","9")&despues$Caracter27_30=="0000")
despues$Condicion_Aval_Area=!(despues$Periodo=="Despues"&despues$Caracter22%in%c("9")&despues$Caracter27_30=="0000")
despues=despues[despues$Condicion_NPredios,]
print("Verificar que las bases a crizar son homogeneas")
print(names(antes)[!names(antes)%in%names(despues)])
print(names(despues)[!names(despues)%in%names(antes)])
antes=antes %>% distinct(FICHA, Periodo, .keep_all = TRUE)
despues=despues %>% distinct(FICHA, Periodo, .keep_all = TRUE)
names(antes)=paste0(names(antes),"_antes")
names(despues)=paste0(names(despues),"_despues")
Ancho=merge(antes,despues,by.x="FICHA_antes",by.y="FICHA_despues",all=TRUE)
Ancho$DESTINO_ECONOMICO_antes=ifelse(is.na(Ancho$DESTINO_ECONOMICO_antes),"Nuevo",Ancho$DESTINO_ECONOMICO_antes)
Ancho$DESTINO_ECONOMICO_despues=ifelse(is.na(Ancho$DESTINO_ECONOMICO_despues),"Eliminado",Ancho$DESTINO_ECONOMICO_despues)
# Tabla de contingencia
df_tabla <- as.data.frame(table(Ancho$DESTINO_ECONOMICO_antes,
Ancho$DESTINO_ECONOMICO_despues))
# Calcular proporción por fila (solo para el fill, no en etiquetas)
df_tabla <- df_tabla %>%
group_by(Var1) %>%
mutate(perc = Freq / sum(Freq) * 100) %>%
ungroup()
con1=unique(as.character(df_tabla$Var1))
con2=unique(as.character(df_tabla$Var2))
Intecepto=intersect(con1,con2)
Diferencia_simetrica=setdiff(union(con1, con2), intersect(con1, con2))
df_tabla$Var1=factor(as.character(df_tabla$Var1),levels=c(Intecepto,Diferencia_simetrica))
df_tabla$Var2=factor(as.character(df_tabla$Var2),levels=c(Intecepto,Diferencia_simetrica))
# Heatmap solo con frecuencia
salida=ggplot(df_tabla, aes(x = Var2, y = Var1, fill = perc)) +
geom_tile(color = "white") +
geom_text(aes(label = Freq), color = "black") +
scale_fill_gradient(low ="#31BA66" , high = "#A78F38") +
labs(x = "Después", y = "Antes", fill = "Cambio") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
return(salida)
}
ggsave(
filename = paste0("grafico_", "Cambio_Destino", ".png"),  # nombre del archivo
plot = Destino_cambio_rel(antes,despues,recuperar,anio1=2025,anio2=2026),               # gráfico
width = 10, height = 8, units = "in",     # tamaño
dpi = 600                                  # resolución máxima
)
Zona_cambio_rel<-function(antes,despues,recuperar,anio1=2025,anio2=2026,Zone=Zona,cuadrado=F){
despues$Periodo="Despues"
despues$Caracter22 <- str_sub(despues$NUMERO_PREDIAL_NACIONAL, 22, 22)
despues$Caracter27_30 <- str_sub(despues$NUMERO_PREDIAL_NACIONAL, 27, 30)
despues$Condicion_NPredios=!(despues$Periodo=="Despues"&despues$Caracter22%in%c("8","9")&despues$Caracter27_30=="0000")
despues$Condicion_Aval_Area=!(despues$Periodo=="Despues"&despues$Caracter22%in%c("9")&despues$Caracter27_30=="0000")
despues=despues[despues$Condicion_NPredios,]
antes$Periodo="Antes"
print("Verificar que las bases a crizar son homogeneas")
print(names(antes)[!names(antes)%in%names(despues)])
print(names(despues)[!names(despues)%in%names(antes)])
antes=antes %>% distinct(FICHA, Periodo, .keep_all = TRUE)
despues=despues %>% distinct(FICHA, Periodo, .keep_all = TRUE)
names(antes)=paste0(names(antes),"_antes")
names(despues)=paste0(names(despues),"_despues")
Ancho=merge(antes,despues,by.x="FICHA_antes",by.y="FICHA_despues",all=TRUE)
Ancho$ZONA_antes=ifelse(is.na(Ancho$ZONA_antes),"Nuevo",Ancho$ZONA_antes)
Ancho$ZONA_despues=ifelse(is.na(Ancho$ZONA_despues),"Eliminado",Ancho$ZONA_despues)
# Tabla de contingencia
df_tabla <- as.data.frame(table(Ancho$ZONA_antes,
Ancho$ZONA_despues))
# Calcular proporción por fila (solo para el fill, no en etiquetas)
df_tabla <- df_tabla %>%
group_by(Var1) %>%
mutate(perc = Freq / sum(Freq) * 100) %>%
ungroup()
con1=unique(as.character(df_tabla$Var1))
con2=unique(as.character(df_tabla$Var2))
#Intecepto=intersect(con1,con2)
#Diferencia_simetrica=setdiff(union(con1, con2), intersect(con1, con2))
#df_tabla$Var1=factor(as.character(df_tabla$Var1),levels=c(Intecepto,Diferencia_simetrica))
#df_tabla$Var2=factor(as.character(df_tabla$Var2),levels=c(Intecepto,Diferencia_simetrica))
# Heatmap solo con frecuencia
if(!cuadrado){
salida=ggplot(df_tabla, aes(x = Freq, y = Var1, fill = Var1)) +
geom_col() +
geom_text(aes(label = Freq), hjust = -0.2) +
scale_fill_manual(values = c("Nuevo"="#31BA66","Rural"="#A78F38","Urbana"="#018D38")) +
labs(x = "Frecuencia", y = "Antes", fill = "Zona antes") +
theme_minimal() +
theme(legend.position = "none")+
xlim(0,max(df_tabla$Freq)*1.2)
}else{
salida=ggplot(df_tabla, aes(x = Var2, y = Var1, fill = perc)) +
geom_tile(color = "white") +
geom_text(aes(label = Freq), color = "black") +
scale_fill_gradient(low ="#31BA66" , high = "#A78F38") +
labs(x = "Después", y = "Antes", fill = "Cambio") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
}
return(salida)
}
ggsave(
filename = paste0("grafico_", "Cambio_zona", ".png"),  # nombre del archivo
