)
Destino1 <- Salida %>%
group_by(Periodo,variable) %>%
summarise(
value1=sum(value)
)
Destino=merge(Destino,Destino1,by=c("Periodo","variable"))
Destino$Porcentaje=scales::percent(Destino$value/Destino$value1,decimal.mark =",",
big.mark=".",accuracy=0.1)
Destino$value=round(Destino$value)
Destino$Label1=formatos(y=Destino$value,x=Destino$variable)
Destino$Label=paste0(Destino$Label1," (",Destino$Porcentaje,")")
Destino$DESTINO_ECONOMICO[is.na(Destino$DESTINO_ECONOMICO)]="Eliminado"
Destino$DESTINO_ECONOMICO[Destino$DESTINO_ECONOMICO=="000"]="Indeterminado"
Destino=Destino[Destino$variable==recuperar,]
Destino$DESTINO_ECONOMICO=factor(Destino$DESTINO_ECONOMICO,levels=unique(Destino$DESTINO_ECONOMICO[order(-Destino$value)]))
Destino$Periodo <- ifelse(Destino$Periodo == "Antes", anio1, anio2)
Destino$Periodo <- factor(Destino$Periodo, levels = c(anio1, anio2))
Destino_completo <- Destino %>%
tidyr::complete(
DESTINO_ECONOMICO,
Periodo,
fill = list(value = 0, Label = "0 (0%)")
)
graph1=ggplot(data = Destino_completo, aes(x = DESTINO_ECONOMICO, y = value, fill = Periodo)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8)) +
geom_text(aes(label = Label),
position = position_dodge(width = 0.8),
hjust = 0.3,  # ligeramente afuera de la barra
size = 3,
vjust = 0.5
) +
coord_flip() +
scale_fill_manual(
values = c("2025" = "#A78F38", "2026" = "#31BA66"),
name = "Periodo"
) +
labs(
x = "Destino Económico",
y = recuperar
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "top",
plot.title = element_text(face = "bold", hjust = 0.5),
axis.text.y = element_text(size = 9),
axis.text.x = element_blank()
)+ylim(c(0,1.6*max(Destino$value)))
return(graph1)
}
