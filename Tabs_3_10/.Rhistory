Predios_por_propietario<-function(antes,despues,anio1=2025,anio2=2026){
despues$Periodo="Despues"
antes$Periodo="Antes"
print("Verificar que las bases a crizar son homogeneas")
print(names(antes)[!names(antes)%in%names(despues)])
print(names(despues)[!names(despues)%in%names(antes)])
Largo=rbind(antes,despues)
S=Largo%>%group_by(NUMERO_DOCUMENTO,Periodo)%>%summarise(Predios_por_propietario=n())
S$Predios_por_propietario=cut(S$Predios_por_propietario,breaks=c(0,1:10,Inf),labels=c(1:10,"+10"))
S1=S%>%group_by(Periodo)%>%summarise(Total1=n())
S=S%>%group_by(Periodo,Predios_por_propietario)%>%summarise(Total=n())
S=merge(S,S1,by="Periodo")
S$Porcentaje=scales::percent(S$Total/S$Total1,accuracy=0.1,big.mark=".",decimal.mark=",")
S$label=paste0(format(S$Total,big.mark=".",decimal.mark=".")," (",S$Porcentaje,")")
S$Periodo <- ifelse(S$Periodo == "Antes", anio1, anio2)
S$Periodo <- factor(S$Periodo, levels = c(anio1, anio2))
graph1=ggplot(S, aes(x = Predios_por_propietario, y = Total, fill = Periodo)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8)) +
geom_text(aes(label = label),
position = position_dodge(width = 0.8),
vjust = 0.1, size = 3) +
coord_flip() +
scale_fill_manual(
values = c("2025" = "#A78F38", "2026" = "#31BA66"),
name = "Periodo")+
labs(
x = "Número de predios por propietario",
y = "Cantidad") +
theme_minimal(base_size = 12) +
theme(
legend.position = "top",
plot.title = element_text(face = "bold", hjust = 0.5),
axis.text.y = element_text(size = 9),
axis.text.x=element_blank())+
ylim(c(0,1.3*max(S$ Total)))
return(graph1)
}
