###########################################################
### FUNCIÓN GRÁFICO PLANO – ELASTICIDAD (INFORME PDF)
###########################################################
grafico_producto_anual_plano <- function(data, producto_sel, anio_sel) {
# -------------------------------
# Validación
# -------------------------------
req_vars <- c("producto", "mes_y_ano", "suma_kg", "precio_prom", "elasticidad")
faltan <- setdiff(req_vars, names(data))
if (length(faltan) > 0) {
stop(paste("Faltan variables:", paste(faltan, collapse = ", ")))
}
# -------------------------------
# Filtro
# -------------------------------
df <- data %>%
mutate(mes_y_ano = as.Date(mes_y_ano)) %>%
filter(
producto == producto_sel,
lubridate::year(mes_y_ano) == anio_sel
)
if (nrow(df) == 0) return(NULL)
# -------------------------------
# Preparación de variables
# -------------------------------
meses_es <- c(
"Enero","Febrero","Marzo","Abril","Mayo","Junio",
"Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"
)
df <- df %>%
mutate(
mes        = lubridate::month(mes_y_ano),
mes_label  = factor(meses_es[mes], levels = meses_es),
suma_ton   = suma_kg / 1000,
elasticidad = ifelse(is.na(elasticidad), 0, elasticidad)
)
# -------------------------------
# Reescalar para un solo eje
# (solo visual, NO altera datos)
# -------------------------------
max_precio <- max(df$precio_prom, na.rm = TRUE)
max_ton    <- max(df$suma_ton, na.rm = TRUE)
max_elast  <- max(abs(df$elasticidad), na.rm = TRUE)
df <- df %>%
mutate(
ton_scaled   = suma_ton   * max_precio / max_ton,
elast_scaled = elasticidad * max_precio / max_elast
)
# -------------------------------
# Gráfico plano FAO
# -------------------------------
g <- ggplot(df, aes(x = mes_label)) +
# Precio
geom_line(
aes(y = precio_prom, color = "Precio promedio"),
linewidth = 1.2,
linetype = "dashed"
) +
geom_point(
aes(y = precio_prom, color = "Precio promedio"),
size = 2.5
) +
# Cantidad
geom_line(
aes(y = ton_scaled, color = "Cantidad (t)"),
linewidth = 1.2,
linetype = "dotted"
) +
geom_point(
aes(y = ton_scaled, color = "Cantidad (t)"),
size = 2.5
) +
# Elasticidad
geom_line(
aes(y = elast_scaled, color = "Elasticidad"),
linewidth = 1.2
) +
geom_point(
aes(y = elast_scaled, color = "Elasticidad"),
size = 2.5
) +
scale_color_manual(
values = c(
"Precio promedio" = "#494634",
"Cantidad (t)"    = "#6D673E",
"Elasticidad"     = "#DBC21F"
)
) +
labs(
x = "Mes",
y = "Índice estandarizado",
color = ""
) +
theme_minimal(base_size = 13) +
theme(
axis.text.x  = element_text(angle = 90, vjust = 0.5, hjust = 1),
legend.position = "bottom",
legend.direction = "horizontal",
panel.grid.minor = element_blank()
)
return(g)
}
