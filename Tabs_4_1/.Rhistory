shiny::runApp("C:/Users/Usuario/Dropbox/SIMAGRO/Tableros/Tabs_3_6")
# --- Configuración Inicial ---
ruta_base <- "C:/Users/Usuario/Dropbox/SIMAGRO/Tableros"
carpetas_serie_3 <- paste0("Tabs_3_", 1:10)
carpetas_serie_4 <- c("Tabs_4_1", "Tabs_4_2")
carpetas_a_revisar <- c(carpetas_serie_3, carpetas_serie_4)
paquetes_encontrados <- character()
# --- Función para buscar paquetes en un archivo (V2) ---
buscar_paquetes <- function(ruta_archivo) {
if (!file.exists(ruta_archivo)) {
return(NULL)
}
# Leemos el archivo COMPLETO como una sola cadena para manejar saltos de línea
contenido_completo <- paste(readLines(ruta_archivo, warn = FALSE), collapse = "\n")
contenido_lineas <- strsplit(contenido_completo, "\n")[[1]]
paquetes <- character()
# 1. Buscar 'library(paquete)' o 'require(paquete)'
patron_lib_req <- "(library|require)\\(\\s*(\\w+)[^\\)]*\\)"
matches_lib_req <- unique(gsub(patron_lib_req, "\\2", grep(patron_lib_req, contenido_lineas, value = TRUE, ignore.case = TRUE)))
paquetes <- c(paquetes, matches_lib_req)
# 2. Buscar 'paquete::funcion' o 'paquete:::funcion'
patron_doble_colon <- "^\\s*(\\w+):{2,3}\\w+"
lineas_con_colon <- grep("::", contenido_lineas, value = TRUE, ignore.case = TRUE)
matches_colon <- unique(gsub(patron_doble_colon, "\\1", grep(patron_doble_colon, lineas_con_colon, value = TRUE, ignore.case = TRUE)))
paquetes <- c(paquetes, matches_colon)
# 3. BUSCAR 'pacman::p_load()' (Múltiples líneas, más simple y robusto)
# Usamos regexec y regmatches para aislar el contenido dentro de los paréntesis de p_load
match_p_load <- regmatches(
contenido_completo,
gregexpr("p_load\\s*\\(([^)]*)\\)", contenido_completo, perl = TRUE, ignore.case = TRUE)
)
if (length(match_p_load[[1]]) > 0) {
# Extraer los argumentos (solo el contenido dentro de los paréntesis)
argumentos_brutos <- sub("p_load\\s*\\((.*)\\)", "\\1", match_p_load[[1]], ignore.case = TRUE)
# Unir todos los argumentos encontrados y limpiarlos
argumentos_limpios <- gsub("(\n|\\s|'|\"|#.*)", "", paste(argumentos_brutos, collapse = ","))
# Dividir por comas (ahora limpias)
lista_paquetes_p_load <- unlist(strsplit(argumentos_limpios, ",", fixed = TRUE))
# Eliminar entradas vacías (resultado de comas al final o dobles comas)
paquetes_p_load <- lista_paquetes_p_load[lista_paquetes_p_load != ""]
paquetes <- c(paquetes, paquetes_p_load)
}
# Limpieza final y unicidad
# Filtro estricto para asegurar que solo sean nombres de paquetes válidos
paquetes_limpios <- sort(unique(paquetes[grepl("^[[:alpha:]][[:alnum:]\\.]*$", paquetes)]))
return(paquetes_limpios)
}
# --- Iteración principal (Sin cambios) ---
for (carpeta in carpetas_a_revisar) {
ruta_carpeta <- file.path(ruta_base, carpeta)
if (dir.exists(ruta_carpeta)) {
# print(paste("🔎 Revisando carpeta:", carpeta)) # Omitido para limpieza
archivos <- list.files(
ruta_carpeta,
pattern = "\\.(R|Rmd)$",
full.names = TRUE,
recursive = FALSE
)
for (archivo in archivos) {
nuevos_paquetes <- buscar_paquetes(archivo)
if (length(nuevos_paquetes) > 0) {
paquetes_encontrados <- unique(c(paquetes_encontrados, nuevos_paquetes))
}
}
}
}
# --- Resultado Final ---
paquetes_finales <- sort(unique(paquetes_encontrados))
cat("\n==================================\n")
cat("✅ LISTA COMPLETA DE PAQUETES NECESARIOS\n")
cat("   (Versión 2: Lógica robusta para p_load multi-línea)\n")
cat("==================================\n")
if (length(paquetes_finales) > 0) {
cat(paste(paquetes_finales, collapse = "\n"))
cat("\n==================================\n")
} else {
cat("No se encontraron paquetes explícitamente cargados.\n")
}
