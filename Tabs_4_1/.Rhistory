antioquia_long <- antioquia_long %>%
mutate(col = paste0(delito, "_", year))
antioquia_wide <- antioquia_long %>%
select(col, valor) %>%
mutate(region = "Antioquia") %>%
pivot_wider(
names_from = col,
values_from = valor
) %>%
select(region, everything())
antioquia_wide <- antioquia_wide %>%
mutate(across(where(is.numeric), ~ round(.x, 2)))
tabla_ancha
View(tabla_ancha)
View(antioquia_wide)
View(medellin_wide)
